  "version": "0.1.0",
  "description": "Vacation negotiation MVP monorepo",
  "scripts": {
    "build": "npm run build --prefix backend/infrastructure-support",
    "test": "npm run test --prefix backend/infrastructure-support",
    "test:unit": "npm run test:unit --prefix backend/infrastructure-support",
    "test:integration": "npm run test:integration --prefix backend/infrastructure-support",
    "ci:local": "npm run test:unit && npm run test:integration",
