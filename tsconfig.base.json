{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/types": [
        "shared/types/src/index.ts"
      ],
      "@shared/adapters": [
        "shared/adapters/src/index.ts"
      ]
    }
  }
}
